# serdev: lets an in-kernel driver own a UART via a DT child node of the port
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
# frame checksum (crc32_le)
CONFIG_CRC32=y
# boot-time measurement and driver debugging
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
